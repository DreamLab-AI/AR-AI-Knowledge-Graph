\@writefile{toc}{\contentsline {section}{\numberline {3}Headline: Local + Ontology vs.\ Frontier Bare}{2}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces F1 by model. The dashed green line marks DiffusionGemma+ontology (0.505). Every frontier model's \emph  {bare} score falls below this line. Grounding lets a local 26B model outperform cloud-hosted frontier models on domain-specific factual recall.}}{2}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Per-model results. All 7 models show positive augmentation delta and reduced hallucination. Claude models show the largest absolute lift; DiffusionGemma's own lift is modest but its grounded score exceeds every frontier bare score.}}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Performance by Question Type}{2}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Hallucination Analysis}{2}{}\protected@file@percent }
\citation{introl2026inference}
\abx@aux@cite{0}{introl2026inference}
\abx@aux@segm{0}{0}{introl2026inference}
\citation{advisori2026gdpr}
\abx@aux@cite{0}{advisori2026gdpr}
\abx@aux@segm{0}{0}{advisori2026gdpr}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Subclass questions show the largest relative lift (+0.573 absolute). Existence questions are easy for both arms (high baseline). Neighbour-recall benefits moderately.}}{3}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Per-model $\times $ per-type F1. Claude models dominate subclass recall when grounded (0.75--1.00); smaller models plateau at 0.50. DiffusionGemma's existence score is strong (0.875) but neighbour recall is weak (0.323).}}{3}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Cost, Privacy, and Inference Economics}{3}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Cost and privacy comparison. DiffusionGemma runs entirely on-premise: no data leaves the organisation, no per-query API cost, lowest latency. The ontology condense pass is a one-off 6-hour batch (7{,}445 classes), not per-query.  {\footnotesize  *Amortised electricity/hardware only; no API billing.}}}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Ontology grounding reduces hallucination for every model. The largest reduction is Haiku (0.714\,$\to $\,0.106, --0.608). Even DiffusionGemma drops from 0.498 to 0.299.}}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Caveats on Lift Interpretation}{4}{}\protected@file@percent }
\newlabel{sec:caveats}{{7}{4}{Caveats on Lift Interpretation}{section.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Grounded-local vs.\ bare-frontier: not like-for-like}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Frontier models benefit far more from grounding}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}DiffusionGemma's own augmentation lift is modest}{4}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Performance varies sharply by question type}{4}{}\protected@file@percent }
